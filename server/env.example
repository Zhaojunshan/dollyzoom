# Creem Dashboard → Settings → API Keys.
# Account review requires a live key: prefix creem_  (not creem_test_).
# Do not commit the real value. This file is only a template.
CREEM_API_KEY=

# Leave unset in production. Sandbox calls do not satisfy Creem review.
# CREEM_ALLOW_TEST_KEY=1

# Signing secret from Creem Dashboard → Developers → Webhooks. Not the API key.
CREEM_WEBHOOK_SECRET=

# Random string, at least 16 characters. Signs the browser session only.
# Example: openssl rand -hex 32
CREEM_SESSION_SECRET=

# Credits debited for one paid HD generation. Creem grants the pack size
# from the product; this process never grants purchased credits.
GENERATION_CREDIT_COST=1

# Temporary plain-text switch for 2 promotional generation credits.
# Leave unset. Set to 1 only while live checkout is blocked, then remove it.
# Any other value disables POST /v1/credits/test-grant.
# TEST_GRANT_ENABLED=1

# Optional. Must stay on dollyzoom.top, www.dollyzoom.top, or localhost.
# Default: https://dollyzoom.top/
# CREEM_SUCCESS_URL=https://dollyzoom.top/

# China (Beijing) Bailian / Model Studio key. Do not commit the value.
# https://help.aliyun.com/zh/model-studio/get-api-key
# Paid HD uses wan2.6-i2v-flash. An empty key fails the task and reverses the debit.
DASHSCOPE_API_KEY=

# Optional. Default is Beijing: https://dashscope.aliyuncs.com
# singapore uses https://dashscope-intl.aliyuncs.com
# DASHSCOPE_REGION=beijing

# Optional. Full https origin. Overrides DASHSCOPE_REGION.
# Use this for a workspace host such as https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
# DASHSCOPE_BASE_URL=

# Optional paid HD settings. Defaults: 720P, 5 seconds, silent.
# WAN_RESOLUTION=720P
# WAN_DURATION=5
# WAN_AUDIO=false

PORT=8787
